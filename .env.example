# Copy into Coolify as environment variables (mark the tokens as secrets).
# For local testing: `cp .env.example .env` and fill in, then `docker compose up`.

# Claude Code on the Max plan, headless: run `claude setup-token` locally, paste the token.
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub token with 'repo' + 'workflow' scope (git push + gh pr create).
GITHUB_TOKEN=

# Codex external review (optional). Either set an OpenAI API key + EXTERNAL_REVIEW=codex,
# or mount ~/.codex/auth.json into the container, or keep EXTERNAL_REVIEW=none.
OPENAI_API_KEY=
EXTERNAL_REVIEW=none

# Repos executr operates on (comma-separated): "name=URL[#branch]" or "URL".
# Single:   REPOS=https://github.com/your-org/your-repo.git#main
# Multiple: REPOS=app=https://github.com/your-org/your-repo.git#main,api=https://github.com/your-org/api.git
# Self-host: include executr itself so it can execute its own docs/plans (e.g. the
#   control-plane plan). The clone lands at /workspace/executr.
REPOS=executr=https://github.com/luiskisters/executr.git#main

# Git identity for commits.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com

# Control-plane (operator UI + orchestrator + Telegram planning). See docs/plans/executr-control-plane.md.
CONTROL_PLANE_PASSWORD=          # single shared password gating the UI/API
CONTROL_PLANE_PORT=8090          # dashboard stays on 8080; control-plane on its own port
TELEGRAM_ALLOWLIST=              # comma-separated Telegram user IDs allowed to plan via the bot

# Voice ask-human + Telegram planning (Telegram + Groq whisper).
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
