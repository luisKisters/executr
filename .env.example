# Copy into Coolify as environment variables (mark the tokens as secrets).
# For local testing: `cp .env.example .env` and fill in, then `docker compose up`.

# Claude Code on the Max plan, headless: run `claude setup-token` locally, paste the token.
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub token with 'repo' + 'workflow' scope (git push + gh pr create).
GITHUB_TOKEN=

# Control-plane Codex execution. Either set an OpenAI API key, or mount ~/.codex/auth.json
# into the node user's Codex home. The legacy ralphex loop keeps EXTERNAL_REVIEW=none.
OPENAI_API_KEY=
EXTERNAL_REVIEW=none

# Bootstrap repos — optional seed (comma-separated): "name=URL[#branch]" or "URL".
# After the first boot the control-plane DB is the source of truth; manage repos from
# the UI (add/archive) without editing this env or restarting the container.
# REPOS is only read on startup to seed the registry; leave it unset once repos have
# been added via the UI, or keep it as a permanent seed for the self-hosted executr repo.
# Self-host: include executr itself so it executes its own docs/plans (e.g. the
#   control-plane plan). The clone lands at /workspace/executr.
REPOS=executr=https://github.com/luiskisters/executr.git#main

# Git identity for commits.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com

# Control-plane (operator UI + orchestrator + Telegram planning). See docs/plans/completed/executr-control-plane.md.
CONTROL_PLANE_PASSWORD=          # single shared password gating the UI/API
CONTROL_PLANE_PORT=8090          # dashboard stays on 8080; control-plane on its own port
HOST=0.0.0.0                    # control-plane bind host
WORKSPACE_ROOT=/workspace        # persistent repo/work state root
ORCHESTRATOR_DB_PATH=            # default: $WORKSPACE_ROOT/.executr/orchestrator.db
CLAIMS_DIR=                      # default: $WORKSPACE_ROOT/.executr/claims
SESSION_SECRET=                  # default: CONTROL_PLANE_PASSWORD
TELEGRAM_ALLOWLIST=              # comma-separated Telegram user IDs allowed to plan via the bot

# Telegram planning + future voice ask-human (Telegram + Groq whisper).
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
