# Copy into Coolify as environment variables (mark the tokens as secrets).
# For local testing: `cp .env.example .env` and fill in, then `docker compose up`.

# Claude Code on the Max plan, headless: run `claude setup-token` locally, paste the token.
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub token with 'repo' + 'workflow' scope (git push + gh pr create).
GITHUB_TOKEN=

# Repos executr operates on (comma-separated): "name=URL[#branch]" or "URL".
# Single:   REPOS=https://github.com/your-org/your-repo.git#main
# Multiple: REPOS=app=https://github.com/your-org/your-repo.git#main,api=https://github.com/your-org/api.git
REPOS=https://github.com/your-org/your-repo.git#main

# Git identity for commits.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com

# Future voice ask-human (Telegram + Groq whisper). Not wired yet.
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
